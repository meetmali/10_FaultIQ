# Local development settings for docker-compose.yml:  cp .env.example .env
# For production or the public demo, use .env.prod.example instead.
# Local-only credentials. Never commit .env.
# Compose builds the API's Npgsql connection string and the worker's DATABASE_URL from these.

APP_ENV=development
ASPNETCORE_ENVIRONMENT=Development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=faultiq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=faultiq
POSTGRES_PORT=5432

# API
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=100

# Host ports
API_PORT=8000
FRONTEND_PORT=5173

