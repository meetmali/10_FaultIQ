# Production / demo settings for compose.prod.yml.
#   cp .env.prod.example .env.prod   (never commit .env.prod)

# Public domain name. Caddy gets HTTPS certificates automatically. Point the domain's DNS A/AAAA record
# at the server first. Use ":80" for plain HTTP (local testing, or behind another TLS proxy).
SITE_ADDRESS=demo.example.org

# true = the public demo: read-only, sample data only, with a banner on every screen.
# false = self-hosting with your own data.
DEMO_MODE=true

# Image source: ghcr.io/<GHCR_OWNER>/faultiq-{api,worker,web}:<FAULTIQ_VERSION>
GHCR_OWNER=meetmali
FAULTIQ_VERSION=latest

# Database. Use a long random password made of hex characters only, because it's embedded in
# connection strings:  openssl rand -hex 32
POSTGRES_USER=faultiq
POSTGRES_PASSWORD=
POSTGRES_DB=faultiq

# Abuse protection and limits
RATE_LIMIT_PER_MINUTE=300
MAX_UPLOAD_SIZE_MB=100
LOG_LEVEL=INFO
