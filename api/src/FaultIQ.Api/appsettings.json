{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "FaultIQ": ""
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Cors": {
    "Origins": "http://localhost:5173"
  },
  "Demo": {
    "Enabled": false
  },
  "RateLimiting": {
    "PermitPerMinute": 300
  },
  "ReverseProxy": {
    "Enabled": false
  },
  "Uploads": {
    "Directory": "./data/uploads",
    "MaxSizeMb": 100
  }
}
