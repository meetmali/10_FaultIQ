    {
      "id": "refrigerant_undercharge",
      "title": "Refrigerant undercharge",
      "equipment": "Refrigerant circuit",
      "dataset": "simulated",
      "dataset_label": "Simulated rooftop unit (LBNL)",
      "intensity_unit": "% undercharge",
      "plain_name": "Low refrigerant",
      "component": "refrigerant_circuit",
      "plain_summary": {
        "text": "The refrigerant charge is below specification, often from a leak; effects in tests were small.",
        "source": "faultiq-eda"
      },
      "what_to_do": {
        "text": "Ask a qualified refrigeration technician to check for leaks and verify the charge.",
        "source": "ashrae-180"
      },
      "definition": {
        "text": "Modelled as a higher refrigerant enthalpy: 10%, 15% and 20% undercharge.",
        "source": "lbnl-rtu"
      },
      "observed": {
        "text": "Small: suction pressure 3 to 22 kPa higher and discharge pressure 3 to 33 kPa lower. The simulated suction pressure rises, the opposite of typical field behaviour, which is a sim-to-real risk.",
        "source": "faultiq-eda"
      },
      "causes": [
        {
          "text": "A refrigerant leak.",
          "source": "ashrae-180"
        },
        {
          "text": "Too little refrigerant added during installation or service.",
          "source": "ashrae-180"
        }
      ],
      "checks": [
        {
          "text": "Have a qualified technician verify the refrigerant charge using the manufacturer's charging method.",
          "source": "ashrae-180"
        },
        {
          "text": "Have the refrigerant circuit checked for leaks before any charge is added.",
          "source": "ashrae-180"
        }
      ],
      "measured": {
        "source": "faultiq-diagnosis",
