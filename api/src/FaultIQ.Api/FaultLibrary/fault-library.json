      "id": "condenser_fouling",
      "title": "Condenser fouling",
      "equipment": "Refrigerant circuit",
      "dataset": "simulated",
      "dataset_label": "Simulated rooftop unit (LBNL)",
      "intensity_unit": "% condenser airflow reduction",
      "plain_name": "Dirty outdoor coil",
      "component": "condenser",
      "plain_summary": {
        "text": "The unit struggles to get rid of heat, so it runs at higher pressure and uses more power to cool.",
        "source": "faultiq-eda"
      },
      "what_to_do": {
        "text": "Ask an HVAC technician to inspect and clean the outdoor (condenser) coil and check its fans.",
        "source": "ashrae-180"
      },
      "definition": {
        "text": "Modelled as reduced condenser fan mass flow, 10% to 50% in five levels.",
        "source": "lbnl-rtu"
      },
      "observed": {
        "text": "Discharge pressure 35 to 358 kPa higher, discharge temperature up to 11 °C higher and compressor power 75 to 693 W higher than the fault-free unit at the same conditions. Supply air moves by 0.4 °C at most, so basic BAS points barely see it.",
        "source": "faultiq-eda"
      },
      "causes": [
        {
          "text": "Dirt, debris or vegetation blocking the condenser coil.",
          "source": "ashrae-180"
        },
        {
          "text": "A condenser fan that has failed or runs slowly.",
          "source": "ashrae-180"
        }
      ],
      "checks": [
        {
          "text": "Inspect the condenser coil for dirt, debris or blockage and clean it if needed.",
          "source": "ashrae-180"
        },
        {
          "text": "Confirm the condenser fans run and nothing obstructs airflow across the coil.",
          "source": "ashrae-180"
        }
      ],
      "measured": {
        "source": "faultiq-diagnosis",
        "symptoms": [
          {
            "feature": "resid:refg_disc_pres",
