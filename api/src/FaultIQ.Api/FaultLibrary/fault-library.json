        "source": "lbnl-rtu"
      },
      "observed": {
        "text": "Supply air 1.0 to 7.3 °C colder and suction pressure 32 to 198 kPa lower than the fault-free unit, scaling with severity. Visible with basic BAS points through supply-air temperature.",
        "source": "faultiq-eda"
      },
      "causes": [
        {
          "text": "Loaded air filters.",
          "source": "ashrae-180"
        },
        {
          "text": "A dirty evaporator coil.",
          "source": "ashrae-180"
        },
        {
          "text": "A slipping belt or weak supply fan reducing airflow.",
          "source": "ashrae-180"
        }
      ],
      "checks": [
        {
          "text": "Inspect the air filters and replace them if they are loaded.",
          "source": "ashrae-180"
        },
        {
          "text": "Inspect the evaporator coil for dirt and clean it if needed.",
          "source": "ashrae-180"
        },
        {
          "text": "Confirm the supply fan and belt are in good condition.",
          "source": "ashrae-180"
        }
