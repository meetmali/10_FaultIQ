{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "api/src/FaultIQ.Api",
        "--urls",
        "http://localhost:8000"
      ],
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
        "DOTNET_NOLOGO": "1"
      },
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "django",
      "runtimeExecutable": "web/.venv/bin/python",
      "runtimeArgs": [
        "web/manage.py",
        "runserver",
        "8010"
      ],
      "env": {
        "AI_WARMUP": "1"
      },
      "port": 8010
    }
  ]
}