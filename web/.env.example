# Copy to web/.env for reference; export these in your shell or set them on your host. Never commit real values.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://user:pass@host:5432/faultiq   (default: SQLite file web/db.sqlite3)
AI_EMBEDDINGS=hybrid        # hybrid | bge | tfidf
AI_WARMUP=0                 # 1 = load the embedding model at startup
ASSISTANT_HOURLY_LIMIT=30
ENERGY_PRICE_PER_KWH=0.13    # USD per kWh for the energy cost estimates
# HF_TOKEN=                 # optional, only raises Hugging Face download rate limits
